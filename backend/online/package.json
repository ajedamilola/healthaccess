{
  "name": "@healthaccess/online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run build --workspace @healthaccess/shared",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "prebuild": "npm run build --workspace @healthaccess/shared && npm run db:generate",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build --workspace @healthaccess/shared && npm run db:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace @healthaccess/shared && npm run db:generate",
    "test": "node --env-file-if-exists=.env --test --import tsx tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "@healthaccess/shared": "*",
    "@langchain/anthropic": "^0.3.15",
    "@langchain/community": "^0.3.35",
    "@langchain/core": "^0.3.42",
    "@langchain/deepseek": "^0.0.1",
    "@langchain/google-genai": "^0.1.11",
    "@langchain/groq": "^0.2.2",
    "@langchain/langgraph": "^0.2.55",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.4",
    "@langchain/openai": "^0.6.17",
    "@prisma/client": "^6.5.0",
    "axios": "^1.8.3",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^5.3.0",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.19",
    "multer": "^2.0.0",
    "nodemailer": "^10.6.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "redis": "^4.7.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}