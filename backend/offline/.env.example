# Leave empty for Docker; compose supplies the included Postgres.
# Set only for direct npm runs.
DATABASE_URL=

# npm run keys:generate. Share CODE_DIGEST_KEY with the future online backend.
CODE_DIGEST_KEY=
DATA_ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# Callback URL: /callbacks/africastalking/<token>/sms/inbound (or sms/delivery,
# ussd, ussd/events). Development accepts callbacks without IP restrictions.
# Production requires comma-separated provider egress CIDRs here.
CALLBACK_ALLOWED_IPS=
CALLBACK_TOKEN=

# No API key = mock SMS, with no network send. Sandbox username is 'sandbox'.
AT_USERNAME=sandbox
AT_API_KEY=
# The actual two-way shortcode/number, also checked against inbound `to`.
AT_SMS_FROM=
AT_USSD_SERVICE_CODE=

# Optional: direct Vercel AI SDK / OpenRouter. Both required to enable AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: AI request limit in ms (default 25000) and SMS thread memory in seconds (default 1800).
AI_TIMEOUT_MS=
SMS_CONVERSATION_TTL_SECONDS=
# Optional: flood ceiling for all provider callbacks per minute (default 6000).
CALLBACK_RATE_PER_MINUTE=
SERPER_API_KEY=

NODE_ENV=development
PORT=3001

# HTTP request logging: off | redacted | full
# The service always logs method, URL, status and duration for every request.
# "full" also logs callback bodies (phone numbers, SMS/USSD text); use it only
# for local debugging. Production defaults to "redacted" when unset.
LOG_HTTP_BODIES=full
