# Leave empty for Docker; compose supplies the included Postgres.
# Set only for direct npm runs.
DATABASE_URL=

# Shared with the offline SMS/USSD service. 32-byte base64 values.
CODE_DIGEST_KEY=
DATA_ENCRYPTION_KEY=
PHONE_DIGEST_KEY=
INPUT_FINGERPRINT_KEY=
ENCRYPTION_KEY_VERSION=1

# JWT access/refresh.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Optional SMTP email delivery, required for password reset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Object storage (AWS S3 or S3-compatible: MinIO, R2).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Leave empty for Docker; compose supplies redis://redis:6379.
# Set only for direct npm runs.
REDIS_URL=redis://localhost:6379

# AI providers. Leave unset to disable the feature with a 503.
# OpenRouter is the preferred provider: one key, OpenAI-compatible, any model slug.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
SERPER_API_KEY=
CHAT_MODEL=openrouter
PRESCRIPTION_MODEL=haiku
MEDICATION_SCHEDULER_MODEL=openrouter

# Firebase Cloud Messaging. Absolute path or JSON string.
FIREBASE_SERVICE_ACCOUNT=
FCM_ENABLED=false

# Africa's Talking outbox (reminders). Offline process sends; online enqueues.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SMS_FROM=

# Server.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
